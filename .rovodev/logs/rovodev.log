13 \t\tfrappe.db.rollback()\n 414 \t\trollback = False\n 415 \n 416 \t# update session\n 417 \tif session := getattr(frappe.local, \"session_obj\", None):\n 418 \t\tif session.update():\n 419 \t\t\trollback = False\n 420 \n 421 \treturn rollback\n 422 \n 423 \n 424 # Always initialize sentry SDK if the DSN is sent\n 425 if sentry_dsn := os.getenv(\"FRAPPE_SENTRY_DSN\"):\n 426 \timport sentry_sdk\n 427 \tfrom sentry_sdk.integrations.argv import ArgvIntegration\n 428 \tfrom sentry_sdk.integrations.atexit import AtexitIntegration\n 429 \tfrom sentry_sdk.integrations.dedupe import DedupeIntegration\n 430 \tfrom sentry_sdk.integrations.excepthook import ExcepthookIntegration\n 431 \tfrom sentry_sdk.integrations.modules import ModulesIntegration\n 432 \tfrom sentry_sdk.integrations.wsgi import SentryWsgiMiddleware\n 433 \n 434 \tfrom frappe.utils.sentry import FrappeIntegration, before_send\n 435 \n 436 \tintegrations = [\n 437 \t\tAtexitIntegration(),\n 438 \t\tExcepthookIntegration(),\n 439 \t\tDedupeIntegration(),\n 440 \t\tModulesIntegration(),\n 441 \t\tArgvIntegration(),\n 442 \t]\n 443 \n 444 \texperiments = {}\n 445 \tkwargs = {}\n 446 \n 447 \tif os.getenv(\"ENABLE_SENTRY_DB_MONITORING\"):\n 448 \t\tintegrations.append(FrappeIntegration())\n 449 \t\texperiments[\"record_sql_params\"] = True\n 450 \n 451 \tif tracing_sample_rate := os.getenv(\"SENTRY_TRACING_SAMPLE_RATE\"):\n 452 \t\tkwargs[\"traces_sample_rate\"] = float(tracing_sample_rate)\n 453 \t\tapplication = SentryWsgiMiddleware(application)\n 454 \n 455 \tif profiling_sample_rate := os.getenv(\"SENTRY_PROFILING_SAMPLE_RATE\"):\n 456 \t\tkwargs[\"profiles_sample_rate\"] = float(profiling_sample_rate)\n 457 \n 458 \tsentry_sdk.init(\n 459 \t\tdsn=sentry_dsn,\n 460 \t\tbefore_send=before_send,\n 461 \t\tattach_stacktrace=True,\n 462 \t\trelease=frappe.__version__,\n 463 \t\tauto_enabling_integrations=False,\n 464 \t\tdefault_integrations=False,\n 465 \t\tintegrations=integrations,\n 466 \t\t_experiments=experiments,\n 467 \t\t**kwargs,\n 468 \t)\n 469 \n 470 \n 471 def serve(\n 472 \tport=8000,\n 473 \tprofile=False,\n 474 \tno_reload=False,\n 475 \tno_threading=False,\n 476 \tsite=None,\n 477 \tsites_path=\".\",\n 478 \tproxy=False,\n 479 ):\n 480 \tglobal application, _site, _sites_path\n 481 \t_site = site\n 482 \t_sites_path = sites_path\n 483 \n 484 \tfrom werkzeug.serving import run_simple\n 485 \n 486 \tif profile or os.environ.get(\"USE_PROFILER\"):\n 487 \t\tapplication = ProfilerMiddleware(application, sort_by=(\"cumtime\", \"calls\"))\n 488 \n 489 \tif not os.environ.get(\"NO_STATICS\"):\n 490 \t\tapplication = application_with_statics()\n 491 \n 492 \tif proxy or os.environ.get(\"USE_PROXY\"):\n 493 \t\tapplication = ProxyFix(application, x_for=1, x_proto=1, x_host=1, x_port=1, x_prefix=1)\n 494 \n 495 \tapplication.debug = True\n 496 \tapplication.config = {\"SERVER_NAME\": \"127.0.0.1:8000\"}\n 497 \n 498 \tlog = logging.getLogger(\"werkzeug\")\n 499 \tlog.propagate = False\n 500 \n 501 \tin_test_env = os.environ.get(\"CI\")\n 502 \tif in_test_env:\n 503 \t\tlog.setLevel(logging.ERROR)\n 504 \n 505 \trun_simple(\n 506 \t\t\"0.0.0.0\",\n 507 \t\tint(port),\n 508 \t\tapplication,\n 509 \t\texclude_patterns=[\"test_*\"],\n 510 \t\tuse_reloader=False if in_test_env else not no_reload,\n 511 \t\tuse_debugger=not in_test_env,\n 512 \t\tuse_evalex=not in_test_env,\n 513 \t\tthreaded=not no_threading,\n 514 \t)\n 515 \n 516 \n 517 def application_with_statics():\n 518 \tglobal application, _sites_path\n 519 \n 520 \tapplication = SharedDataMiddleware(application, {\"/assets\": str(os.path.join(_sites_path, \"assets\"))})\n 521 \n 522 \tapplication = StaticDataMiddleware(application, {\"/files\": str(os.path.abspath(_sites_path))})\n 523 \n 524 \treturn application\n 525 \n 526 \n 527 # Remove references to pattern that are pre-compiled and loaded to global scopes.\n 528 re.purge()\n 529 \n 530 # Both Gunicorn and RQ use forking to spawn workers. In an ideal world