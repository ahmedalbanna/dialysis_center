sions evaluated in scripted ways\n  97 \n  98 # permission_query_conditions = {\n  99 # \t"Event": "frappe.desk.doctype.event.event.get_permission_query_conditions",\n 100 # }\n 101 #\n 102 # has_permission = {\n 103 # \t"Event": "frappe.desk.doctype.event.event.has_permission",\n 104 # }\n 105 \n 106 # DocType Class\n 107 # ---------------\n 108 # Override standard doctype classes\n 109 \n 110 # override_doctype_class = {\n 111 # \t"ToDo": "custom_app.overrides.CustomToDo"\n 112 # }\n 113 \n 114 # Document Events\n 115 # ---------------\n 116 # Hook on document methods and events\n 117 \n 118 doc_events = {\n 119 \t"Dialysis Session": {\n 120 \t\t"on_submit": "dialysis_center.api.billing.create_invoice_from_session",\n 121 \t\t"on_update": "dialysis_center.patient_management.doctype.dialysis_session.dialysis_session.update_patient_last_session"\n 122 \t},\n 123 \t"Payment": {\n 124 \t\t"on_submit": "dialysis_center.billing_management.doctype.payment.payment.update_invoice_payment"\n 125 \t}\n 126 }\n 127 \n 128 # Scheduled Tasks\n 129 # ---------------\n 130 \n 131 scheduler_events = {\n 132 \t"daily": [\n 133 \t\t"dialysis_center.tasks.send_appointment_reminders",\n 134 \t\t"dialysis_center.tasks.check_overdue_invoices"\n 135 \t],\n 136 \t"hourly": [\n 137 \t\t"dialysis_center.tasks.update_machine_status"\n 138 \t],\n 139 \t"cron": {\n 140 \t\t"0 8 * * *": [\n 141 \t\t\t"dialysis_center.tasks.generate_daily_schedule_report"\n 142 \t\t]\n 143 \t}\n 144 }\n 145 \n 146 # Testing\n 147 # -------\n 148 \n 149 # before_tests = "dialysis_center.install.before_tests"\n 150 \n 151 # Overriding Methods\n 152 # ------------------------------\n 153 #\n 154 # override_whitelisted_methods = {\n 155 # \t"frappe.desk.doctype.event.event.get_events": "dialysis_center.event.get_events"\n 156 # }\n 157 #\n 158 # each overriding function accepts a `data` argument;\n 159 # generated from the base implementation of the doctype dashboard,\n 160 # along with any modifications made in other Frappe apps\n 161 # override_doctype_dashboards = {\n 162 # \t"Task": "dialysis_center.task.get_dashboard_data"\n 163 # }\n 164 \n 165 # exempt linked doctypes from being automatically cancelled\n 166 #\n 167 # auto_cancel_exempted_doctypes = ["Auto Repeat"]\n 168 \n 169 # Ignore links to specified DocTypes when deleting documents\n 170 # -----------------------------------------------------------\n 171 \n 172 # ignore_links_on_delete = ["Communication", "ToDo"]\n 173 \n 174 \n 175 # User Data Protection\n 176 # --------------------\n 177 \n 178 # user_data_fields = [\n 179 # \t{\n 180 # \t\t"doctype": "{doctype_1}",\n 181 # \t\t"filter_by": "{filter_by}",\n 182 # \t\t"redact_fields": ["{field_1}", "{field_2}"],\n 183 # \t\t"partial": 1,\n 184 # \t},\n 185 # \t{\n 186 # \t\t"doctype": "{doctype_2}",\n 187 # \t\t"filter_by": "{filter_by}",\n 188 # \t\t"partial": 1,\n 189 # \t},\n 190 # \t{\n 191 # \t\t"doctype": "{doctype_3}",\n 192 # \t\t"strict": False,\n 193 # \t},\n 194 # \t{\n 195 # \t\t"doctype": "{doctype_4}"\n 196 # \t}\n 197 # ]\n 198 \n 199 # Authentication and authorization\n 200 # --------------------------------\n 201 \n 202 # auth_hooks = [\n 203 # \t"dialysis_center.auth.validate"\n 204 # ]\n 205 \n 206 # Whitelisted API Methods (Phase 2: Comprehensive APIs)\n 207 # -------------------------------------------------------\n 208 # All API methods are exported here for frontend/mobile client access\n 209 \n 210 whitelisted_methods = {\n 211 \t# Patient Management APIs\n 212 \t"dialysis_center.api.patient.get_patient_list": "read",\n 213 \t"dialysis_center.api.patient.get_patient_details": "read",\n 214 \t"dialysis_center.api.patient.create_patient": "write",\n 215 \t"dialysis_center.api.patient.update_patient": "write",\n 216 \t"dialysis_center.api.patient.get_patient_sessions": "read",\n 217 \t"dialysis_center.api.patient.get_patient_lab_results": "read",\n 218 \t"dialysis_center.api.patient.get_patient_dashboard": "read",\n 219 \t"dialysis_center.api