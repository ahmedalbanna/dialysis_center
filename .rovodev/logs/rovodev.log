zard.memory.md\n\nscripts/:\nbackup-database.sh\ndocker-commands.sh\nrestore-database.sh\nsetup-auto-backup.sh\nverify-docker-setup.sh\n\n.yarn/:\n\n.yarn/bin/: (COLLAPSED)\n</workspace>", "timestamp": "2026-02-24T04:07:52.670350+00:00", "dynamic_ref": null, "part_kind": "system-prompt"}
