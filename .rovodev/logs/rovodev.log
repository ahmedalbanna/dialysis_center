msgprint({\\n  78 \\t\\t\\t\\t\\ttitle: __(\'Invalid Email\'),\\n  79 \\t\\t\\t\\t\\tmessage: __(\'Please enter a valid email address\'),\\n  80 \\t\\t\\t\\t\\tindicator: \'orange\'\\n  81 \\t\\t\\t\\t});\\n  82 \\t\\t\\t}\\n  83 \\t\\t}\\n  84 \\t}\\n  85 });\\n  86 \\n  87 function calculate_age(frm) {\\n  88 \\tif (frm.doc.date_of_birth) {\\n  89 \\t\\tconst dob = new Date(frm.doc.date_of_birth);\\n  90 \\t\\tconst today = new Date();\\n  91 \\t\\tlet age = today.getFullYear() - dob.getFullYear();\\n  92 \\t\\tconst month_diff = today.getMonth() - dob.getMonth();\\n  93 \\t\\t\\n  94 \\t\\tif (month_diff < 0 || (month_diff === 0 && today.getDate() < dob.getDate())) {\\n  95 \\t\\t\\tage--;\\n  96 \\t\\t}\\n  97 \\t\\t\\n  98 \\t\\tfrm.set_value(\'age\', age);\\n  99 \\t\\t\\n 100 \\t\\t// Show warning for unusual ages\\n 101 \\t\\tif (age < 18) {\\n 102 \\t\\t\\tfrappe.msgprint({\\n 103 \\t\\t\\t\\ttitle: __(\'Minor Patient\'),\\n 104 \\t\\t\\t\\tmessage: __(\'Patient is under 18 years old\'),\\n 105 \\t\\t\\t\\tindicator: \'orange\'\\n 106 \\t\\t\\t});\\n 107 \\t\\t} else if (age > 100) {\\n 108 \\t\\t\\tfrappe.msgprint({\\n 109 \\t\\t\\t\\ttitle: __(\'Please Verify\'),\\n 110 \\t\\t\\t\\tmessage: __(\'Patient age appears to be {0} years. Please verify date of birth.\', [age]),\\n 111 \\t\\t\\t\\tindicator: \'orange\'\\n 112 \\t\\t\\t});\\n 113 \\t\\t}\\n 114 \\t}\\n 115 }\\n 116 \\n 117 function show_patient_stats(frm) {\\n 118 \\t// Fetch and display patient statistics\\n 119 \\tfrappe.call({\\n 120 \\t\\tmethod: \'dialysis_center.api.patient.get_patient_dashboard\',\\n 121 \\t\\targs: {\\n 122 \\t\\t\\tpatient: frm.doc.name\\n 123 \\t\\t},\\n 124 \\t\\tcallback: function(r) {\\n 125 \\t\\t\\tif (r.message && r.message.statistics) {\\n 126 \\t\\t\\t\\tconst stats = r.message.statistics;\\n 127 \\t\\t\\t\\t\\n 128 \\t\\t\\t\\t// Create HTML for stats\\n 129 \\t\\t\\t\\tconst stats_html = `\\n 130 \\t\\t\\t\\t\\t<div class=\\"row patient-stats\\" style=\\"margin: 15px 0;\\">\\n 131 \\t\\t\\t\\t\\t\\t<div class=\\"col-sm-3\\">\\n 132 \\t\\t\\t\\t\\t\\t\\t<div class=\\"stat-card\\" style=\\"background: #e6f7ff; padding: 15px; border-radius: 5px; text-align: center;\\">\\n 133 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"font-size: 24px; font-weight: bold; color: #1890ff;\\">${stats.total_sessions || 0}</div>\\n 134 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"color: #666; font-size: 12px;\\">Total Sessions</div>\\n 135 \\t\\t\\t\\t\\t\\t\\t</div>\\n 136 \\t\\t\\t\\t\\t\\t</div>\\n 137 \\t\\t\\t\\t\\t\\t<div class=\\"col-sm-3\\">\\n 138 \\t\\t\\t\\t\\t\\t\\t<div class=\\"stat-card\\" style=\\"background: #f6ffed; padding: 15px; border-radius: 5px; text-align: center;\\">\\n 139 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"font-size: 24px; font-weight: bold; color: #52c41a;\\">${stats.completed_sessions || 0}</div>\\n 140 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"color: #666; font-size: 12px;\\">Completed Sessions</div>\\n 141 \\t\\t\\t\\t\\t\\t\\t</div>\\n 142 \\t\\t\\t\\t\\t\\t</div>\\n 143 \\t\\t\\t\\t\\t\\t<div class=\\"col-sm-3\\">\\n 144 \\t\\t\\t\\t\\t\\t\\t<div class=\\"stat-card\\" style=\\"background: #fff7e6; padding: 15px; border-radius: 5px; text-align: center;\\">\\n 145 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"font-size: 24px; font-weight: bold; color: #faad14;\\">${stats.upcoming_appointments || 0}</div>\\n 146 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"color: #666; font-size: 12px;\\">Upcoming Appointments</div>\\n 147 \\t\\t\\t\\t\\t\\t\\t</div>\\n 148 \\t\\t\\t\\t\\t\\t</div>\\n 149 \\t\\t\\t\\t\\t\\t<div class=\\"col-sm-3\\">\\n 150 \\t\\t\\t\\t\\t\\t\\t<div class=\\"stat-card\\" style=\\"background: #fff1f0; padding: 15px; border-radius: 5px; text-align: center;\\">\\n 151 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"font-size: 24px; font-weight: bold; color: #f5222d;\\">${format_currency(stats.total_outstanding || 0)}</div>\\n 152 \\t\\t\\t\\t\\t\\t\\t\\t<div style=\\"color: #666; font-size: 12px;\\">Outstanding Amount</div>\\n 153 \\t\\t\\t\\t