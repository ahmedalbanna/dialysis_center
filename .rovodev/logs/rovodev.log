sql.gz 2>/dev/null); do\\n  50         local size=$(du -h \\"$backup\\" | cut -f1)\\n  51         local date=$(stat -c %y \\"$backup\\" | cut -d\'.\' -f1)\\n  52         local filename=$(basename \\"$backup\\")\\n  53         \\n  54         echo -e \\"${BLUE}[$count]${NC} $filename\\"\\n  55         echo \\"    Date: $date\\"\\n  56         echo \\"    Size: $size\\"\\n  57         \\n  58         # Show info file if exists\\n  59         local info_file=\\"${backup%.sql.gz}.info\\"\\n  60         if [ -f \\"$info_file\\" ]; then\\n  61             local tables=$(grep \\"Tables\\" \\"$info_file\\" 2>/dev/null || echo \\"\\")\\n  62             [ -n \\"$tables\\" ] && echo \\"    $tables\\"\\n  63         fi\\n  64         echo \\"\\"\\n  65         \\n  66         count=$((count + 1))\\n  67     done\\n  68 }\\n  69 \\n  70 # Function to restore from backup\\n  71 restore_backup() {\\n  72     local backup_file=\\"$1\\"\\n  73     \\n  74     if [ ! -f \\"$backup_file\\" ]; then\\n  75         echo_error \\"Backup file not found: $backup_file\\"\\n  76     fi\\n  77     \\n  78     echo_warning \\"WARNING: This will replace the current database!\\"\\n  79     echo_info \\"Database: $DB_NAME\\"\\n  80     echo_info \\"Backup: $(basename $backup_file)\\"\\n  81     echo \\"\\"\\n  82     \\n  83     read -p \\"Are you sure you want to continue? (yes/no): \\" -r\\n  84     if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then\\n  85         echo_info \\"Restore cancelled\\"\\n  86         exit 0\\n  87     fi\\n  88     \\n  89     # Check if container is running\\n  90     if ! docker ps | grep -q \\"$CONTAINER_NAME\\"; then\\n  91         echo_error \\"MariaDB container is not running!\\"\\n  92     fi\\n  93     \\n  94     # Create a pre-restore backup\\n  95     echo_info \\"Creating pre-restore backup...\\"\\n  96     PRE_RESTORE_BACKUP=\\"$BACKUP_DIR/pre_restore_$(date +%Y%m%d_%H%M%S).sql.gz\\"\\n  97     docker exec \\"$CONTAINER_NAME\\" mysqldump \\\\\\n  98         -u root \\\\\\n  99         -p\\"$MYSQL_ROOT_PASSWORD\\" \\\\\\n 100         --single-transaction \\\\\\n 101         --quick \\\\\\n 102         \\"$DB_NAME\\" | gzip > \\"$PRE_RESTORE_BACKUP\\"\\n 103     echo_success \\"Pre-restore backup saved: $PRE_RESTORE_BACKUP\\"\\n 104     \\n 105     # Drop and recreate database\\n 106     echo_info \\"Dropping and recreating database...\\"\\n 107     docker exec \\"$CONTAINER_NAME\\" mysql -u root -p\\"$MYSQL_ROOT_PASSWORD\\" -e \\"DROP DATABASE IF EXISTS \\\\`$DB_NAME\\\\`;\\"\\n 108     docker exec \\"$CONTAINER_NAME\\" mysql -u root -p\\"$MYSQL_ROOT_PASSWORD\\" -e \\"CREATE DATABASE \\\\`$DB_NAME\\\\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\\"\\n 109     echo_success \\"Database recreated\\"\\n 110     \\n 111     # Restore from backup\\n 112     echo_info \\"Restoring database from backup...\\"\\n 113     zcat \\"$backup_file\\" | docker exec -i \\"$CONTAINER_NAME\\" mysql -u root -p\\"$MYSQL_ROOT_PASSWORD\\" \\"$DB_NAME\\"\\n 114     \\n 115     if [ $? -eq 0 ]; then\\n 116         echo_success \\"Database restored successfully!\\"\\n 117         \\n 118         # Verify restoration\\n 119         echo_info \\"Verifying restoration...\\"\\n 120         TABLES=$(docker exec \\"$CONTAINER_NAME\\" mysql -u root -p\\"$MYSQL_ROOT_PASSWORD\\" -e \\"SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = \'$DB_NAME\';\\" | tail -1)\\n 121         echo_success \\"Tables restored: $TABLES\\"\\n 122     else\\n 123         echo_error \\"Restore failed!\\"\\n 124     fi\\n 125 }\\n 126 \\n 127 # Main script\\n 128 echo \\"========================================\\"\\n 129 echo \\"Frappe Database Restore Utility\\"\\n 130 echo \\"========================================\\"\\n 131 echo \\"\\"\\n 132 \\n 133 # Parse arguments\\n 134 if [ $# -eq 0 ]; then\\n 135     # Interactive mode - list backups\\n 136     list_backups\\n 137     \\n 138     echo \\"\\"\\n 139     read -p \\"Enter backup number to restore (or \'q\' to quit): \\" choice\\n 140     \\n 141     if [ \\"$choice\\" == \\"q\\" ] || [ \\"$choice\\" == \\"Q\\" ]; then\\n 142         echo_info \\"Restore cancelled\\"\\n 143         exit 0\\n 144     fi\\n 145     \\n 146     # Get the selected backup\\n 147     BACKUP_FILE=$(ls -t \\"$BACKUP_DIR\\"/frappe_db_*.sql.gz 2>/dev/null | sed -n \\"${choice}p\\")\\n 148     \\n 149     if [ -z \\"$BACKUP_FILE\\" ]; then\\n 150         echo_error \\"Invalid selection\\"\\n 151     fi\\n 152     \\n 153     restore_backup \\"$BACKUP_FILE\\"\\n 154 else\\n 155     # Command line mode - restore specific file\\n 156     BACKUP_FILE=\\"$1\\"\\n 157     \\n 158     if [ ! -f \\"$BACKUP_FILE\\" ]; then\\n 159         # Try to find in backup directory\\n 160         BACKUP_FILE=\\"$BACKUP_DIR/$1\\"\\n 161     fi\\n 162     \\n 163     restore_backup \\"$BACKUP_FILE\\"\\n 164 fi\\n 165 \\n 166 echo \\"\\"\\n 167 echo_success \\"Restore process completed!\\"\\n 168 \\n````"]'}
