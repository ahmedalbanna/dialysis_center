tal_trends\": \"read\",\n 223 \t\n 224 \t# Appointment APIs\n 225 \t\"dialysis_center.api.appointment.get_appointment_list\": \"read\",\n 226 \t\"dialysis_center.api.appointment.get_appointment_details\": \"read\",\n 227 \t\"dialysis_center.api.appointment.create_appointment\": \"write\",\n 228 \t\"dialysis_center.api.appointment.update_appointment\": \"write\",\n 229 \t\"dialysis_center.api.appointment.check_machine_availability\": \"read\",\n 230 \t\"dialysis_center.api.appointment.check_in_appointment\": \"write\",\n 231 \t\"dialysis_center.api.appointment.get_available_slots\": \"read\",\n 232 \t\"dialysis_center.api.appointment.bulk_schedule_appointments\": \"write\",\n 233 \t\"dialysis_center.api.appointment.get_daily_schedule\": \"read\",\n 234 \t\"dialysis_center.api.appointment.cancel_appointment\": \"write\",\n 235 \t\"dialysis_center.api.appointment.reschedule_appointment\": \"write\",\n 236 \t\n 237 \t# Session APIs\n 238 \t\"dialysis_center.api.session.get_session_list\": \"read\",\n 239 \t\"dialysis_center.api.session.get_session_details\": \"read\",\n 240 \t\"dialysis_center.api.session.start_session\": \"write\",\n 241 \t\"dialysis_center.api.session.end_session\": \"write\",\n 242 \t\"dialysis_center.api.session.record_vital_signs\": \"write\",\n 243 \t\"dialysis_center.api.session.get_session_events\": \"read\",\n 244 \t\"dialysis_center.api.session.get_active_sessions\": \"read\",\n 245 \t\"dialysis_center.api.session.get_session_vital_history\": \"read\",\n 246 \t\"dialysis_center.api.session.get_session_statistics\": \"read\",\n 247 \t\"dialysis_center.api.session.complete_session\": \"write\",\n 248 \t\"dialysis_center.api.session.add_vital_reading\": \"write\",\n 249 \t\"dialysis_center.api.session.log_session_event\": \"write\",\n 250 \t\n 251 \t# Billing APIs\n 252 \t\"dialysis_center.api.billing.get_invoice_list\": \"read\",\n 253 \t\"dialysis_center.api.billing.get_invoice_details\": \"read\",\n 254 \t\"dialysis_center.api.billing.create_invoice\": \"write\",\n 255 \t\"dialysis_center.api.billing.submit_invoice\": \"write\",\n 256 \t\"dialysis_center.api.billing.record_payment\": \"write\",\n 257 \t\"dialysis_center.api.billing.get_outstanding_invoices\": \"read\",\n 258 \t\"dialysis_center.api.billing.get_financial_summary\": \"read\",\n 259 \t\"dialysis_center.api.billing.create_invoice_from_session\": \"write\",\n 260 \t\"dialysis_center.api.billing.get_payment_history\": \"read\",\n 261 \t\"dialysis_center.api.billing.get_revenue_summary\": \"read\",\n 262 \t\"dialysis_center.api.billing.apply_discount\": \"write\",\n 263 \t\n 264 \t# Lab Management APIs\n 265 \t\"dialysis_center.api.lab.get_lab_test_list\": \"read\",\n 266 \t\"dialysis_center.api.lab.create_lab_test\": \"write\",\n 267 \t\"dialysis_center.api.lab.submit_lab_test\": \"write\",\n 268 \t\"dialysis_center.api.lab.get_lab_results\": \"read\",\n 269 \t\"dialysis_center.api.lab.get_trending_results\": \"read\",\n 270 \t\n 271 \t# Inventory Management APIs\n 272 \t\"dialysis_center.api.inventory.get_medication_list\": \"read\",\n 273 \t\"dialysis_center.api.inventory.get_medication_details\": \"read\",\n 274 \t\"dialysis_center.api.inventory.create_stock_movement\": \"write\",\n 275 \t\"dialysis_center.api.inventory.get_low_stock_items\": \"read\",\n 276 \t\"dialysis_center.api.inventory.check_medication_expiry\": \"read\",\n 277 \t\n 278 \t# Staff Management APIs\n 279 \t\"dialysis_center.api.staff.get_staff_list\": \"read\",\n 280 \t\"dialysis_center.api.staff.get_staff_details\": \"read\",\n 281 \t\"dialysis_center.api.staff.get_staff_shifts\": \"read\",\n 282 \t\"dialysis_center.api.staff.get_available_staff\": \"read\",\n 283 \t\n 284 \t# Equipment Management APIs\n 285 \t\"dialysis_center.api.equipment.get_machine_list\": \"read\",\n 286 \t\"dialysis_center.api.equipment.get_machine_details\": \"read\",\n 287 \t\"dialysis_center.api.equipment.get_machine_maintenance_schedule\": \"read\",\n 288 \t\"dialysis_center.api.equipment.record_machine_maintenance\": \"write\",\n 289 \t\"dialysis_center.api.equipment.get_machines_due_maintenance\": \"read\",\n 290 \t\n 291 \t# Insurance Management APIs\n 292 \t\"dialysis_center.api.insurance.get_insurance_provider_list\": \"read\",\n 293 \t\"dialysis_center.api.insurance.create_insurance_claim\": \"write\",\n 294 \t\"dialysis_center.api.insurance.get_claim_status\": \"read\",\n 295 \t\"dialysis_center.api.insurance.get_patient_claims\": \"read\",\n 296 }\n 297 \n 298 # ============================================================================\n 299 # PHASE 4: WORKFLOWS AND AUTOMATION\n 300 # ============================================================================\n 301 \n 302 # Document Lifecycle Hooks (before_insert, before_save, on_submit, on_cancel)\n 303 # ============================================================================\n 304 doc_events = {\n 305 \t# Appointment Hooks\n 306 \t\"Appointment\": {\n 307 \t\t\"before_insert\": \"dialysis_center.workflows.hooks_automation.appointment_before_insert\",\n 308 \t\t\"before_save\": \"dialysis_center.workflows.hooks_automation.appointment_before_save\",\n 309 \t\t\"on_submit\": \"dialysis_center.workflows.hooks_automation.appointment_on_submit\",\n 310 \t\t\"on_cancel\": \"dialysis_center.workflows.hooks_automation.appointment_on_cancel\",\n 311 \t},\n 312 \t# Dialysis Session Hooks\n 313 \t\"Dialysis Session\": {\n 314 \t\t\"before_insert\": \"dialysis_center.workflows.hooks_automation.dialysis_session_before_insert\",\n 315 \t\t\"before_save\": \"dialysis_center.workflows.hooks_automation.dialysis_session_before_save\",\n 316 \t\t\"on_submit\": \"dialysis_center.workflows.hooks_automation.dialysis_session_on_submit\",\n 317 \t\t\"on_cancel\": \"dialysis_center.workflows.hooks_automation.dialysis_session_on_cancel\",\n 318 \t},\n 319 \t# Invoice Hooks\n 320 \t\"Invoice\": {\n 321 \t\t\"before_insert\": \"dialysis_center.workflows.hooks_automation.invoice_before_insert\",\n 322 \t\t\"before_save\": \"dialysis_center.workflows.hooks_automation.invoice_before_save\",\n 323 \t\t\"on_submit\": \"dialysis_center.workflows.hooks_automation.invoice_on_submit\",\n 324 \t\t\"on_cancel\": \"dialysis_center.workflows.hooks_automation.invoice_on_cancel\",\n 325 \t},\n 326 \t# Lab Test Hooks\n 327 \t\"Lab Test\": {\n 328 \t\t\"before_insert\": \"dialysis_center.workflows.hooks_automation.lab_test_before_insert\",\n 329 \t\t\"before_save\": \"dialysis_center.workflows.hooks_automation.lab_test_before_save\",\n 330 \t\t\"on_submit\": \"dialysis_center.workflows.hooks_automation.lab_test_on_submit\",\n 331 \t},\n 332 \t# Insurance Claim Hooks\n 333 \t\"Insurance Claim\": {\n 334 \t\t\"before_insert\": \"dialysis_center.workflows.hooks_automation.insurance_claim_before_insert\",\n 335 \t\t\"before_save\": \"dialysis_center.workflows.hooks_automation.insurance_claim_before_save\",\n 336 \t\t\"on_submit\": \"dialysis_center.workflows.hooks_automation.insurance_claim_on_submit\",\n 337 \t\t\"on_cancel\": \"dialysis_center.workflows.hooks_automation.insurance_claim_on_cancel\",\n 338 \t},\n 339 }\n 340 \n 341 # Scheduled Background Tasks\n 342 # ============================================================================\n 343 scheduler_events = {\n 344 \t\"daily\": [\n 345 \t\t\"dialysis_center.workflows.scheduled_tasks.daily_invoice_reminders\",\n 346 \t\t\"dialysis_center.workflows.scheduled_tasks.daily_equipment_maintenance_alerts\",\n 347 \t\t\"dialysis_center.workflows.scheduled_tasks.daily_lab_result_notifications\",\n 348 \t\t\"dialysis_center.workflows.scheduled_tasks.daily_patient_followup_tasks\",\n 349 \t\t\"dialysis_center.workflows.scheduled_tasks.daily_patient_vitals_alert\",\n 350 \t],\n 351 \t\"weekly\": [\n 352 \t\t\"dialysis_center.workflows.scheduled_tasks.weekly_equipment_status_report\",\n 353 \t\t\"dialysis_center.workflows.scheduled_tasks.weekly_invoice_aging_report\",\n 354 \t],\n 355 \t\"monthly\": [\n 356 \t\t\"dialysis_center.workflows.scheduled_tasks.monthly_machine_performance_report\",\n 357 \t\t\"dialysis_center.workflows.scheduled_tasks.monthly_patient_treatment_compliance\",\n 358 \t],\n 359 }\n 360 \n 361 # Fixtures\n 362 # --------\n 363 # Export fixtures to app on running bench export-fixtures\n 364 fixtures = [\n 365 \t\"Role\",\n 366 \t{\"dt\": \"Treatment Template\", \"filters\": [[\"is_active\", \"=\", 1]]},\n 367 ]\n 368 \n 369 # After Migrate Hook (for development auto-seeding)\n 370 # --------------------------------------------------\n 371 # Uncomment to auto-seed test data after each migration (dev only)\n 372 # after_migrate = \"dialysis_center.fixtures.seed_dev_data.check_and_seed_if_empty\"\n 373 \n 374 # Custom Bench Commands\n 375 # ---------------------\n 376 # Accessible via: bench --site [sitename] dialysis-center [command]\n 377 # Commands: seed-data, clear-test-data, show-stats\n 378 \n````", "tool_call_id": "toolu_vrtx_011GvVjEDaFd7FcjUeBCcNGT", "metadata": null, "timestamp": "2026-02-24T04:09:00.353089+00:00", "part_kind": "tool-return"}
