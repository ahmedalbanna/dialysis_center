 0) return `${mins}m`;\\n\\tif (mins === 0) return `${hours}h`;\\n\\treturn `${hours}h ${mins}m`;\\n}\\n\\nexport function formatBloodPressure(systolic, diastolic) {\\n\\tif (!systolic || !diastolic) return \'\';\\n\\treturn `${systolic}/${diastolic} mmHg`;\\n}\\n\\nexport function formatTemperature(temp, unit = \'C\') {\\n\\tif (temp === null || temp === undefined) return \'\';\\n\\treturn `${formatNumber(temp, 1)}°${unit}`;\\n}\\n\\nexport function getInitials(name) {\\n\\tif (!name) return \'\';\\n\\tconst parts = name.trim().split(\' \');\\n\\tif (parts.length === 1) return parts[0].charAt(0).toUpperCase();\\n\\treturn (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();\\n}\\n\\nexport function formatRelativeTime(date) {\\n\\tif (!date) return \'\';\\n\\treturn frappe.datetime.comment_when(date);\\n}\\n\\nexport function truncateText(text, maxLength = 50) {\\n\\tif (!text) return \'\';\\n\\tif (text.length <= maxLength) return text;\\n\\treturn text.substring(0, maxLength) + \'...\';\\n}\\nEOF\\necho \\"✅ Formatters created\\""}', 'logfire.msg': 'running tool: bash', 'logfire.json_schema': '{"type": "object", "properties": {"tool_arguments": {"type": "object"}, "tool_response": {"type": "object"}, "gen_ai.tool.name": {}, "gen_ai.tool.call.id": {}}}', 'logfire.span_type': 'span', 'tool_response': '✅ Formatters created'}
